# Supabase project settings (never commit real keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Google Maps Platform - enable Routes API and Places API; restrict key by API and server IP
GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_GOOGLE_MAPS_KEY

# Optional LINE Messaging API credentials; keep server-side only
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OFFICIAL_ACCOUNT_ID=

# Public website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
